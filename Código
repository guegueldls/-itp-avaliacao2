#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void mediageral(int a, double medias[]){
    double soma = 0;
    int i;

    for(i = 0; i < a; i++){
        soma += medias[i];
    }

    printf("Média geral da turma: %.1lf\n", soma / a);
}

void encontrarMaior(int a, double medias[]){
    double maior = medias[0];
    int i;
    
    for(i = 1; i < a; i++){
        if(maior < medias[i]){
            maior = medias[i];
        }
    }
    printf("Maior média da turma: %.1lf\n", maior);
}

void calcMedia(int a, double notas[10][3], double media[]){
    double soma;
    int i, j;

    for(i = 0; i < a; i++){
        soma = 0;
        for(j = 0; j < 3; j++){
            soma += notas[i][j];
        }
        media[i] = soma / 3.0; 
    }
}

void situacao(double mediaAluno){
    if(mediaAluno >= 6.0){
        printf("Situação: Atingiu a meta\n");
    } else {
        printf("Situação: Nao atingiu a meta\n");
    }
}

int main(){
    char alunos[10][50];
    double notas[10][3];
    int i, j, a;

    printf("Quantos alunos ha na sala (1 a 10)?\n");
    scanf("%d", &a);
    
    if(a < 1 || a > 10){
        printf("Erro! Somente uma quantidade de alunos entre 1 e 10.\n");
        return 1;
    }

    double *medias = (double *) malloc(a * sizeof(double));
    
    if (medias == NULL) {
        printf("Erro de alocacao de memoria!\n");
        return 1;
    }

    for(i = 0; i < a; i++) {
        medias[i] = 0.0;
    }

    printf("Quais seus nomes?\n");
    for(i = 0; i < a; i++){
        scanf("%s", alunos[i]);
        
        if (strlen(alunos[i]) == 0) {
            printf("Erro: Nome nao pode ser vazio!\n");
            free(medias);
            return 1;
        }
    }
    
    printf("Quais foram suas notas (intervalo de 0.0 a 10.0)?\n");
    for(i = 0; i < a; i++){
        for(j = 0; j < 3; j++){
            scanf("%lf", &notas[i][j]);

            if(notas[i][j] < 0.0 || notas[i][j] > 10.0){
                printf("Erro! Nota invalida. Digite valores entre 0.0 e 10.0.\n");
                free(medias); 
                return 1;
            }
        }
    }

    calcMedia(a, notas, medias);

    printf("\n--- Relatório Individual dos Alunos ---\n");
    for(i = 0; i < a; i++){
        printf("Aluno: %s\n", alunos[i]);
        printf("Notas: %.1lf, %.1lf, %.1lf\n", notas[i][0], notas[i][1], notas[i][2]);
        printf("Media: %.1lf\n", medias[i]);
        situacao(medias[i]);
        printf("\n");
    }

    printf("--- Estatísticas Gerais ---\n");
    mediageral(a, medias);
    encontrarMaior(a, medias);

    free(medias);

    return 0;
}
